<UserControl x:Class="STEX.Inv.Desktop.UI.Views.LibrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="32,28,32,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Libros"
                               FontSize="30" FontWeight="Black"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="Conteos capturados en este equipo y su estado de subida."
                               FontSize="14"
                               Foreground="{DynamicResource AppMutedBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Actualizar"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource AppAccentTextBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Height="38"
                            Padding="16,0" />
                </StackPanel>
            </Grid>

            <Border CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppSuccessBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppDangerBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Background="{DynamicResource AppDangerBackgroundBrush}"
                    BorderBrush="{DynamicResource AppDangerBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasDuplicateDrafts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource AppDangerTextBrush}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DuplicateDraftsMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppDangerTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="10,0,16,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Resolver duplicados"
                            Command="{Binding ResolveDuplicateDraftsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource AppDangerTextBrush}"
                            BorderBrush="{DynamicResource AppDangerBorderBrush}"
                            Height="34"
                            Padding="12,0" />
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="BookOpenVariant"
                                                 Width="26" Height="26"
                                                 Foreground="{DynamicResource AppAccentTextBrush}" />
                        <TextBlock Text="LIBROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Libros.Count}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{DynamicResource AppTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                 Width="26" Height="26"
                                                 Foreground="{DynamicResource AppAccentTextBrush}" />
                        <TextBlock Text="REGISTROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalRegistros}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{DynamicResource AppTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ScaleBalance"
                                                 Width="26" Height="26"
                                                 Foreground="{DynamicResource AppAccentTextBrush}" />
                        <TextBlock Text="PESO TOTAL"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalPesoText}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{DynamicResource AppTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,28,0,12"
                  Visibility="{Binding HasLibros, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Libros de conteo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="Marca los libros para exportarlos. Copiar abre la elección de campaña."
                               FontSize="12"
                               Foreground="{DynamicResource AppMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Exportar seleccionados"
                            Command="{Binding ExportSelectedCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource AppAccentTextBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Height="36"
                            Padding="14,0" />
                    <Button Content="Descargar todos"
                            Command="{Binding ExportAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource AppAccentTextBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            Height="36"
                            Padding="14,0"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding PagedLibros}"
                          Visibility="{Binding HasLibros, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0"
                                              AutomationProperties.Name="Seleccionar libro para exportar" />

                                    <Border Grid.Column="1"
                                            Width="44" Height="44" CornerRadius="12"
                                            Background="{DynamicResource AppAccentSoftBrush}">
                                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                                 Width="22" Height="22"
                                                                 Foreground="{DynamicResource AppAccentDarkBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CampanaNombre}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}" />
                                        <TextBlock Text="{Binding UltimaActualizacionTexto, StringFormat=Última captura: {0}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedBrush}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding LibroIdTexto}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppMutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sincronizado}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppSuccessBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EstadoTexto}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentDarkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sincronizado}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="REGISTROS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Registros}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="UNIDADES"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding Unidades}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PESO NETO"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding PesoNetoTexto}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OPERARIO"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedBrush}" />
                                        <TextBlock Text="{Binding OperarioNombre}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">
                                    <Button Content="Copiar"
                                            Command="{Binding DataContext.CopyBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource AppAccentTextBrush}"
                                            Height="30"
                                            Padding="10,0" />
                                    <Button Content="Eliminar"
                                            Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource AppDangerTextBrush}"
                                            Height="30"
                                            Padding="10,0"
                                            Margin="4,0,0,0" />
                                </StackPanel>

                                <Expander Header="Ver detalle"
                                          Margin="0,14,0,0"
                                          Foreground="{DynamicResource AppMutedBrush}">
                                    <ItemsControl ItemsSource="{Binding Lineas}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding MaterialDescripcion}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding OperarioNombre, StringFormat=Operario: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource AppMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding KardexNumero, StringFormat=Kardex: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource AppMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Observacion, StringFormat=Observación: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource AppMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Unidades, StringFormat={}{0} unid.}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Presentacion}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding PesoNeto, StringFormat={}{0:0.##} kg}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AppTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0"
                  Visibility="{Binding HasMultiplePages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Anterior"
                            Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource AppAccentTextBrush}"
                            Height="30"
                            Padding="10,0" />
                    <TextBlock Text="{Binding PageText}"
                               FontSize="12"
                               Foreground="{DynamicResource AppMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0" />
                    <Button Content="Siguiente"
                            Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource AppAccentTextBrush}"
                            Height="30"
                            Padding="10,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="48" Height="48"
                                             Foreground="{DynamicResource AppMutedBrush}"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="Aún no hay libros de conteo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,4" />
                    <TextBlock Text="Los registros que guardes desde el módulo Conteo aparecerán aquí."
                               FontSize="13"
                               Foreground="{DynamicResource AppMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
