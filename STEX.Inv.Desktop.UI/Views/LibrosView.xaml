<UserControl x:Class="STEX.Inv.Desktop.UI.Views.LibrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="LibrosBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="LibrosSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LibrosBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="LibrosTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="LibrosMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="LibrosAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="LibrosAccentSoftBrush" Color="#EEF2FF" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource LibrosBackgroundBrush}">
        <StackPanel Margin="32,28,32,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Libros"
                               FontSize="30" FontWeight="Black"
                               Foreground="{StaticResource LibrosTextBrush}" />
                    <TextBlock Text="Conteos guardados en este equipo."
                               FontSize="14"
                               Foreground="{StaticResource LibrosMutedBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Actualizar"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{StaticResource LibrosAccentBrush}"
                        BorderBrush="{StaticResource LibrosAccentBrush}"
                        Height="38"
                        Padding="16,0"
                        VerticalAlignment="Top" />
            </Grid>

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="BookOpenVariant"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="LIBROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Libros.Count}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="REGISTROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalRegistros}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ScaleBalance"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="PESO TOTAL"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalPesoText}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Libros de conteo"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource LibrosTextBrush}"
                       Margin="0,28,0,12" />

            <ItemsControl ItemsSource="{Binding Libros}"
                          Visibility="{Binding HasLibros, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource LibrosSurfaceBrush}"
                                BorderBrush="{StaticResource LibrosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="{StaticResource LibrosAccentSoftBrush}">
                                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                                 Width="22" Height="22"
                                                                 Foreground="{StaticResource LibrosAccentBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CampanaNombre}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}" />
                                        <TextBlock Text="{Binding UltimaActualizacionTexto, StringFormat=Última captura: {0}}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource LibrosMutedBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource LibrosAccentSoftBrush}"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Guardado local"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosAccentBrush}" />
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="REGISTROS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Registros}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="UNIDADES"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Unidades}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PESO NETO"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding PesoNetoTexto}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OPERARIOS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Operarios}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource LibrosSurfaceBrush}"
                    BorderBrush="{StaticResource LibrosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="48" Height="48"
                                             Foreground="{StaticResource LibrosMutedBrush}"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="Aún no hay libros de conteo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource LibrosTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,4" />
                    <TextBlock Text="Los registros que guardes desde el módulo Conteo aparecerán aquí."
                               FontSize="13"
                               Foreground="{StaticResource LibrosMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
