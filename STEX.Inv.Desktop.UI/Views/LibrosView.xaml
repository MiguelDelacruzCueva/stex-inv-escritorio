<UserControl x:Class="STEX.Inv.Desktop.UI.Views.LibrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="LibrosBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="LibrosSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LibrosBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="LibrosTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="LibrosMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="LibrosAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="LibrosAccentSoftBrush" Color="#EEF2FF" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource LibrosBackgroundBrush}">
        <StackPanel Margin="32,28,32,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Libros"
                               FontSize="30" FontWeight="Black"
                               Foreground="{StaticResource LibrosTextBrush}" />
                    <TextBlock Text="Conteos capturados en este equipo y su estado de subida."
                               FontSize="14"
                               Foreground="{StaticResource LibrosMutedBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Exportar CSV"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource LibrosAccentBrush}"
                            BorderBrush="{StaticResource LibrosAccentBrush}"
                            Height="38"
                            Padding="16,0"
                            Margin="0,0,8,0" />
                    <Button Content="Actualizar"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource LibrosAccentBrush}"
                            BorderBrush="{StaticResource LibrosAccentBrush}"
                            Height="38"
                            Padding="16,0" />
                </StackPanel>
            </Grid>

            <Border CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Setter Property="BorderBrush" Value="#FECACA" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#047857" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <UniformGrid Columns="3" Margin="0,24,0,0">
                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="BookOpenVariant"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="LIBROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Libros.Count}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="REGISTROS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalRegistros}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource LibrosSurfaceBrush}"
                        BorderBrush="{StaticResource LibrosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ScaleBalance"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource LibrosAccentBrush}" />
                        <TextBlock Text="PESO TOTAL"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource LibrosMutedBrush}"
                                   Margin="0,12,0,2" />
                        <TextBlock Text="{Binding TotalPesoText}"
                                   FontSize="30" FontWeight="Black"
                                   Foreground="{StaticResource LibrosTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Libros de conteo"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource LibrosTextBrush}"
                       Margin="0,28,0,12" />

            <ItemsControl ItemsSource="{Binding Libros}"
                          Visibility="{Binding HasLibros, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource LibrosSurfaceBrush}"
                                BorderBrush="{StaticResource LibrosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="{StaticResource LibrosAccentSoftBrush}">
                                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                                 Width="22" Height="22"
                                                                 Foreground="{StaticResource LibrosAccentBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CampanaNombre}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}" />
                                        <TextBlock Text="{Binding UltimaActualizacionTexto, StringFormat=Última captura: {0}}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource LibrosMutedBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource LibrosAccentSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sincronizado}" Value="True">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EstadoTexto}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource LibrosAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sincronizado}" Value="True">
                                                            <Setter Property="Foreground" Value="#047857" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="REGISTROS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Registros}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="UNIDADES"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Unidades}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PESO NETO"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding PesoNetoTexto}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="OPERARIOS"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosMutedBrush}" />
                                        <TextBlock Text="{Binding Operarios}"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>

                                <Expander Header="Ver detalle"
                                          Margin="0,14,0,0"
                                          Foreground="{StaticResource LibrosMutedBrush}">
                                    <ItemsControl ItemsSource="{Binding Lineas}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LibrosBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding MaterialDescripcion}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource LibrosTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding OperarioNombre, StringFormat=Operario: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource LibrosMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding KardexNumero, StringFormat=Kardex: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource LibrosMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Observacion, StringFormat=Observación: {0}}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource LibrosMutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Unidades, StringFormat={}{0} unid.}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Presentacion}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding PesoNeto, StringFormat={}{0:0.##} kg}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource LibrosTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource LibrosSurfaceBrush}"
                    BorderBrush="{StaticResource LibrosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="40"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="48" Height="48"
                                             Foreground="{StaticResource LibrosMutedBrush}"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="Aún no hay libros de conteo"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource LibrosTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,4" />
                    <TextBlock Text="Los registros que guardes desde el módulo Conteo aparecerán aquí."
                               FontSize="13"
                               Foreground="{StaticResource LibrosMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
