<UserControl x:Class="STEX.Inv.Desktop.UI.Views.PinEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Focusable="True"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="KeypadButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Button Content="← Volver"
                Command="{Binding BackCommand}"
                Style="{StaticResource MaterialDesignFlatButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="24,20,0,0"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">

            <Border Width="72" Height="72" CornerRadius="36"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <TextBlock Text="{Binding Initials}"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{Binding OperatorName}"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,4"/>

            <TextBlock Text="Ingresa tu PIN"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="{Binding PinDots}"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <TextBlock Text="{Binding LockMessage}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,4"
                       Visibility="{Binding LockMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <UniformGrid Columns="3" Margin="0,16,0,0" HorizontalAlignment="Center">
                <Button Content="1" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="1"/>
                <Button Content="2" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="2"/>
                <Button Content="3" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="3"/>
                <Button Content="4" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="4"/>
                <Button Content="5" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="5"/>
                <Button Content="6" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="6"/>
                <Button Content="7" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="7"/>
                <Button Content="8" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="8"/>
                <Button Content="9" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="9"/>
                <Button Content="C" Style="{StaticResource KeypadButton}" Command="{Binding ClearCommand}"/>
                <Button Content="0" Style="{StaticResource KeypadButton}" Command="{Binding DigitCommand}" CommandParameter="0"/>
                <Button Content="⌫" Style="{StaticResource KeypadButton}" Command="{Binding BackspaceCommand}"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
