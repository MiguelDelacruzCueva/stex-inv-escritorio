<UserControl x:Class="STEX.Inv.Desktop.UI.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ProfileBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="ProfileSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ProfileBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="ProfileTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ProfileMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ProfileAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="ProfileAccentSoftBrush" Color="#EEF2FF" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource ProfileBackgroundBrush}">
        <StackPanel Margin="32,28,32,32" MaxWidth="1000" HorizontalAlignment="Center">
            <TextBlock Text="Perfil"
                       FontSize="30" FontWeight="Black"
                       Foreground="{StaticResource ProfileTextBrush}" />
            <TextBlock Text="Información del operario y del equipo vinculado."
                       FontSize="14"
                       Foreground="{StaticResource ProfileMutedBrush}"
                       Margin="0,6,0,24" />

            <Border Background="{StaticResource ProfileSurfaceBrush}"
                    BorderBrush="{StaticResource ProfileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{StaticResource ProfileAccentSoftBrush}">
                        <TextBlock Text="{Binding Initials}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ProfileAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OperatorName}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ProfileTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <materialDesign:PackIcon Kind="StorefrontOutline"
                                                     Width="15" Height="15"
                                                     Foreground="{StaticResource ProfileMutedBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="{Binding WarehouseName}"
                                       FontSize="13"
                                       Foreground="{StaticResource ProfileMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2"
                            CornerRadius="10"
                            Padding="12,5"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#ECFDF5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionExpired}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SessionStatus}"
                                   FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#047857" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSessionExpired}" Value="True">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource ProfileSurfaceBrush}"
                        BorderBrush="{StaticResource ProfileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Operario"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="CORREO"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding Email}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="ROL"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding Role}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="ÚLTIMA SINCRONIZACIÓN"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding LastSyncText}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource ProfileSurfaceBrush}"
                        BorderBrush="{StaticResource ProfileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Equipo vinculado"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="ALMACÉN"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding WarehouseName}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="VINCULADO EL"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding BoundAtText}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="SESIÓN VÁLIDA HASTA"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource ProfileMutedBrush}" />
                        <TextBlock Text="{Binding ExpiresAtText}"
                                   FontSize="13"
                                   Foreground="{StaticResource ProfileTextBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource ProfileSurfaceBrush}"
                    BorderBrush="{StaticResource ProfileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Acciones de la sesión"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource ProfileTextBrush}" />
                    <TextBlock Text="Cerrar sesión mantiene el equipo vinculado. Desvincular elimina la sesión y los datos locales del almacén."
                               FontSize="12"
                               Foreground="{StaticResource ProfileMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Cerrar sesión"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{StaticResource ProfileAccentBrush}"
                                BorderBrush="{StaticResource ProfileAccentBrush}"
                                Height="40"
                                Padding="18,0" />
                        <Button Content="Desvincular equipo"
                                Command="{Binding UnbindCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#B91C1C"
                                BorderBrush="#FECACA"
                                Height="40"
                                Padding="18,0"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
