<UserControl x:Class="STEX.Inv.Desktop.UI.Views.ConteoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ConteoBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="ConteoSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ConteoBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="ConteoTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ConteoMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ConteoAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="ConteoAccentSoftBrush" Color="#EEF2FF" />

        <Style x:Key="ConteoFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ConteoMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ConteoComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ConteoTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource ConteoAccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CampaignItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{StaticResource ConteoSurfaceBrush}"
                                BorderBrush="{StaticResource ConteoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />

                                <Border x:Name="Check"
                                        Grid.Column="1"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="Transparent"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                    <materialDesign:PackIcon x:Name="CheckIcon"
                                                             Kind="Check"
                                                             Width="14" Height="14"
                                                             Foreground="White"
                                                             Visibility="Collapsed"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C7D2FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ConteoAccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFF" />
                                <Setter TargetName="Check" Property="Background" Value="{StaticResource ConteoAccentBrush}" />
                                <Setter TargetName="Check" Property="BorderBrush" Value="{StaticResource ConteoAccentBrush}" />
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ConteoAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeChipStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource ConteoBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ConteoAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ConteoAccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ConteoAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ConteoAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ConteoAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConteoGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource ConteoMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource ConteoBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ConteoGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ConteoTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ConteoGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ConteoSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ConteoBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Paso 1: campaña -->
                <StackPanel Margin="32,28,32,32"
                            MinWidth="640"
                            MaxWidth="900"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsSelectingCampaign, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Conteo"
                               FontSize="30" FontWeight="Black"
                               Foreground="{StaticResource ConteoTextBrush}" />
                    <TextBlock Text="Selecciona la campaña abierta sobre la que vas a trabajar."
                               FontSize="14"
                               Foreground="{StaticResource ConteoMutedBrush}"
                               Margin="0,6,0,24" />

                    <Border Background="{StaticResource ConteoSurfaceBrush}"
                            BorderBrush="{StaticResource ConteoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="Campañas disponibles"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource ConteoTextBrush}" />
                            <TextBlock Text="El equipo descargó estas campañas en la última sincronización."
                                       FontSize="12"
                                       Foreground="{StaticResource ConteoMutedBrush}"
                                       Margin="0,3,0,16" />

                            <ListBox ItemsSource="{Binding Campanas}"
                                     SelectedItem="{Binding SelectedCampaign}"
                                     ItemContainerStyle="{StaticResource CampaignItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasCampaigns, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConteoTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <materialDesign:PackIcon Kind="CalendarRange"
                                                                         Width="15" Height="15"
                                                                         Foreground="{StaticResource ConteoMutedBrush}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding RangoFechas}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource ConteoMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource ConteoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24"
                                    Visibility="{Binding HasNoCampaigns, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarRemoveOutline"
                                                             Width="40" Height="40"
                                                             Foreground="{StaticResource ConteoMutedBrush}"
                                                             HorizontalAlignment="Center" />
                                    <TextBlock Text="No hay campañas disponibles"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource ConteoTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Sincroniza el equipo para descargar las campañas abiertas."
                                               FontSize="12"
                                               Foreground="{StaticResource ConteoMutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360" />
                                    <Button Content="Sincronizar ahora"
                                            Command="{Binding SyncCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="{StaticResource ConteoAccentBrush}"
                                            BorderBrush="{StaticResource ConteoAccentBrush}"
                                            Height="38"
                                            Padding="16,0"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,20,0,0"
                                  Visibility="{Binding HasCampaigns, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Campaña seleccionada"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource ConteoMutedBrush}" />
                                    <TextBlock Text="{Binding CampaignName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource ConteoTextBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Continuar"
                                        Command="{Binding ContinueCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="42"
                                        Padding="24,0"
                                        Background="{StaticResource ConteoAccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Paso 2: captura -->
                <StackPanel Margin="32,28,32,32"
                            Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Registrar conteo"
                                       FontSize="30" FontWeight="Black"
                                       Foreground="{StaticResource ConteoTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <materialDesign:PackIcon Kind="CalendarCheckOutline"
                                                         Width="16" Height="16"
                                                         Foreground="{StaticResource ConteoAccentBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,7,0" />
                                <TextBlock Text="{Binding CampaignName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ConteoAccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Cambiar campaña"
                                Command="{Binding ChangeCampaignCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{StaticResource ConteoAccentBrush}"
                                BorderBrush="{StaticResource ConteoAccentBrush}"
                                Height="38"
                                Padding="16,0"
                                VerticalAlignment="Top" />
                    </Grid>

                    <Border Background="{StaticResource ConteoSurfaceBrush}"
                            BorderBrush="{StaticResource ConteoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Nuevo registro"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource ConteoTextBrush}" />
                            <TextBlock Text="Completa los datos del material que estás contando."
                                       FontSize="12"
                                       Foreground="{StaticResource ConteoMutedBrush}"
                                       Margin="0,3,0,20" />

                            <TextBlock Text="Tipo de conteo"
                                       Style="{StaticResource ConteoFieldLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <RadioButton Content="Hilo"
                                             GroupName="TipoConteo"
                                             Style="{StaticResource TypeChipStyle}"
                                             IsChecked="{Binding IsHilo, Mode=TwoWay}" />
                                <RadioButton Content="Crudo"
                                             GroupName="TipoConteo"
                                             Style="{StaticResource TypeChipStyle}"
                                             IsChecked="{Binding IsCrudo, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Text="Material"
                                       Style="{StaticResource ConteoFieldLabel}" />
                            <ComboBox ItemsSource="{Binding FilteredMaterials}"
                                      SelectedItem="{Binding SelectedMaterial}"
                                      Text="{Binding MaterialSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      IsDropDownOpen="{Binding IsMaterialDropDownOpen, Mode=TwoWay}"
                                      TextSearch.TextPath="Display"
                                      ItemContainerStyle="{StaticResource ConteoComboItemStyle}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="{StaticResource ConteoSurfaceBrush}"
                                      Foreground="{StaticResource ConteoTextBrush}"
                                      BorderBrush="{StaticResource ConteoBorderBrush}"
                                      FontSize="14"
                                      Margin="0,0,0,18">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5">
                                            <TextBlock Text="{Binding CodigoInterno}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ConteoTextBrush}" />
                                            <TextBlock Text="{Binding Descripcion}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource ConteoTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KardexNumero, StringFormat=Kardex: {0}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ConteoMutedBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Código de kardex"
                                       Style="{StaticResource ConteoFieldLabel}" />
                            <TextBox Text="{Binding Kardex}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Background="#F8FAFC"
                                     Foreground="#374151"
                                     BorderBrush="{StaticResource ConteoBorderBrush}"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Unidades"
                                               Style="{StaticResource ConteoFieldLabel}" />
                                    <TextBox Text="{Binding UnidadesText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Background="{StaticResource ConteoSurfaceBrush}"
                                             Foreground="{StaticResource ConteoTextBrush}"
                                             BorderBrush="{StaticResource ConteoBorderBrush}"
                                             CaretBrush="{StaticResource ConteoTextBrush}"
                                             FontSize="14" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Presentaciones"
                                               Style="{StaticResource ConteoFieldLabel}" />
                                    <TextBox Text="{Binding PresentacionesText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Background="{StaticResource ConteoSurfaceBrush}"
                                             Foreground="{StaticResource ConteoTextBrush}"
                                             BorderBrush="{StaticResource ConteoBorderBrush}"
                                             CaretBrush="{StaticResource ConteoTextBrush}"
                                             FontSize="14" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Peso neto (KG)"
                                               Style="{StaticResource ConteoFieldLabel}" />
                                    <TextBox Text="{Binding PesoNetoText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Background="{StaticResource ConteoSurfaceBrush}"
                                             Foreground="{StaticResource ConteoTextBrush}"
                                             BorderBrush="{StaticResource ConteoBorderBrush}"
                                             CaretBrush="{StaticResource ConteoTextBrush}"
                                             FontSize="14" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Observación"
                                       Style="{StaticResource ConteoFieldLabel}" />
                            <ComboBox ItemsSource="{Binding Observaciones}"
                                      SelectedItem="{Binding Observacion}"
                                      ItemContainerStyle="{StaticResource ConteoComboItemStyle}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Background="{StaticResource ConteoSurfaceBrush}"
                                      Foreground="{StaticResource ConteoTextBrush}"
                                      BorderBrush="{StaticResource ConteoBorderBrush}"
                                      FontSize="14"
                                      Width="320"
                                      HorizontalAlignment="Left" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Agregar conteo"
                                        Command="{Binding AddCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="42"
                                        Padding="24,0"
                                        Background="{StaticResource ConteoAccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        IsDefault="True" />
                                <Button Content="Limpiar"
                                        Command="{Binding ClearFormCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="42"
                                        Padding="16,0"
                                        Margin="8,0,0,0"
                                        Foreground="{StaticResource ConteoMutedBrush}" />
                            </StackPanel>

                            <Border CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECFDF5" />
                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Height="18"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                <Setter Property="Foreground" Value="#047857" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Kind" Value="AlertCircleOutline" />
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#047857" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource ConteoSurfaceBrush}"
                            BorderBrush="{StaticResource ConteoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Registros de esta campaña"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource ConteoTextBrush}" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="12"
                                               Foreground="{StaticResource ConteoMutedBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Registros}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="{StaticResource ConteoSurfaceBrush}"
                                      BorderThickness="0"
                                      RowStyle="{StaticResource ConteoGridRow}"
                                      CellStyle="{StaticResource ConteoGridCell}"
                                      ColumnHeaderStyle="{StaticResource ConteoGridHeader}"
                                      Margin="0,14,0,0"
                                      Visibility="{Binding HasRegistros, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MATERIAL"
                                                        Binding="{Binding MaterialDescripcion}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="KARDEX"
                                                        Binding="{Binding KardexNumero}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="TIPO"
                                                        Binding="{Binding Tipo}"
                                                        Width="75" />
                                    <DataGridTextColumn Header="UNID."
                                                        Binding="{Binding Unidades}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="PRESENT."
                                                        Binding="{Binding Presentaciones}"
                                                        Width="85" />
                                    <DataGridTextColumn Header="PESO (KG)"
                                                        Binding="{Binding PesoNeto, StringFormat={}{0:0.##}}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="OBSERVACIÓN"
                                                        Binding="{Binding Observacion}"
                                                        Width="120" />
                                    <DataGridTemplateColumn Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLineCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Width="30" Height="30"
                                                        Padding="0"
                                                        ToolTip="Eliminar registro">
                                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                                             Width="17" Height="17"
                                                                             Foreground="#B91C1C" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource ConteoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="24"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasNoRegistros, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                             Width="36" Height="36"
                                                             Foreground="{StaticResource ConteoMutedBrush}"
                                                             HorizontalAlignment="Center" />
                                    <TextBlock Text="Aún no hay registros en esta campaña"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource ConteoTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="Los materiales que agregues aparecerán aquí."
                                               FontSize="12"
                                               Foreground="{StaticResource ConteoMutedBrush}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
