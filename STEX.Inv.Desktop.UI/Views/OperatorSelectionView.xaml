<UserControl x:Class="STEX.Inv.Desktop.UI.Views.OperatorSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OperatorBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="OperatorSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="OperatorBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="OperatorTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="OperatorMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="OperatorAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="OperatorAccentSoftBrush" Color="#EEF2FF" />

        <Style x:Key="OperatorCardButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="220" />
            <!-- Ajuste: Cambiado de altura estática a dinámica para evitar que se corte el texto -->
            <Setter Property="MinHeight" Value="160" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OperatorBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{StaticResource OperatorSurfaceBrush}"
                BorderBrush="{StaticResource OperatorBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{StaticResource OperatorAccentBrush}">
                        <materialDesign:PackIcon Kind="Warehouse"
                                                 Width="22" Height="22"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STEX-INV"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource OperatorTextBrush}" />
                        <TextBlock Text="{Binding WarehouseName}"
                                   FontSize="12"
                                   Foreground="{StaticResource OperatorMutedBrush}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Acciones del equipo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding UnbindCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="40"
                            Padding="12,0"
                            Foreground="#B91C1C">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LinkOff"
                                                     Width="18" Height="18"
                                                     Foreground="#B91C1C"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Desvincular equipo"
                                       Foreground="#B91C1C"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24"
                            Background="{StaticResource OperatorBorderBrush}"
                            Margin="10,0,12,0" />

                    <Button Command="{Binding SyncCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Padding="16,0"
                            Background="{StaticResource OperatorAccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsBusy}"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSyncOutline"
                                                     Width="18" Height="18"
                                                     Foreground="White"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Sincronizar"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="Selecciona tu operario"
                           FontSize="30" FontWeight="Black"
                           Foreground="{StaticResource OperatorTextBrush}" />
                <TextBlock Text="Elige tu nombre para ingresar el PIN de 4 dígitos."
                           FontSize="14"
                           Foreground="{StaticResource OperatorMutedBrush}"
                           Margin="0,6,0,24" />

                <!-- Aviso de sincronización -->
                <Border CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,16"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="AlertCircleOutline"
                                                 Width="20" Height="20"
                                                 Foreground="#B91C1C"
                                                 VerticalAlignment="Top"
                                                 Margin="0,1,10,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="No se pudo sincronizar"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#991B1B" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="#B91C1C"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Re-vincular"
                                Command="{Binding ReenrollCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#B91C1C"
                                BorderBrush="#FCA5A5"
                                Height="34"
                                Padding="12,0"
                                Margin="14,0,0,0" />
                    </Grid>
                </Border>

                <!-- Buscador -->
                <!-- Ajuste: Añadido HintAssist.Background y corregido el modo Flotante -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Buscar operario" 
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OperatorTextBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{StaticResource OperatorTextBrush}"
                             Background="{StaticResource OperatorSurfaceBrush}"
                             BorderBrush="{StaticResource OperatorBorderBrush}"
                             CaretBrush="{StaticResource OperatorTextBrush}"
                             FontSize="14"
                             Height="48"
                             Padding="12,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Título de la lista -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,12">
                    <TextBlock Text="Operarios"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource OperatorTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource OperatorAccentSoftBrush}"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Operators.Count}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource OperatorAccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Lista de operarios -->
                <Grid>
                    <ItemsControl ItemsSource="{Binding Operators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OperatorCardButtonStyle}"
                                        Command="{Binding DataContext.SelectOperatorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Card"
                                            Background="{StaticResource OperatorSurfaceBrush}"
                                            BorderBrush="{StaticResource OperatorBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource OperatorAccentSoftBrush}">
                                                <TextBlock Text="{Binding Iniciales}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource OperatorAccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding NombreCompleto}"
                                                       Margin="0,14,0,0"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OperatorTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />

                                            <Border Grid.Row="2"
                                                    BorderBrush="#F1F5F9"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,10,0,0"
                                                    Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Ingresar con PIN"
                                                               FontSize="12"
                                                               Foreground="{StaticResource OperatorMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <materialDesign:PackIcon Grid.Column="1"
                                                                             Kind="ChevronRight"
                                                                             Width="16" Height="16"
                                                                             Foreground="{StaticResource OperatorAccentBrush}"
                                                                             VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{StaticResource OperatorAccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="#F8FAFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{StaticResource OperatorAccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado vacío -->
                    <Border Background="{StaticResource OperatorSurfaceBrush}"
                            BorderBrush="{StaticResource OperatorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="32"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <materialDesign:PackIcon Kind="AccountSearchOutline"
                                                     Width="44" Height="44"
                                                     Foreground="{StaticResource OperatorMutedBrush}"
                                                     HorizontalAlignment="Center" />
                            <TextBlock Text="No hay operarios disponibles"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource OperatorTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="Sincroniza el almacén o ajusta la búsqueda."
                                       FontSize="13"
                                       Foreground="{StaticResource OperatorMutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,16" />
                            <Button Content="Sincronizar ahora"
                                    Command="{Binding SyncCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource OperatorAccentBrush}"
                                    BorderBrush="{StaticResource OperatorAccentBrush}"
                                    HorizontalAlignment="Center"
                                    Height="38"
                                    Padding="16,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>