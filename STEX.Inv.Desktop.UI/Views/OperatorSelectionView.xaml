<UserControl x:Class="STEX.Inv.Desktop.UI.Views.OperatorSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>

        <Style x:Key="OperatorCardButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="220" />
            <!-- Ajuste: Cambiado de altura estática a dinámica para evitar que se corte el texto -->
            <Setter Property="MinHeight" Value="160" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{DynamicResource AppAccentBrush}">
                        <materialDesign:PackIcon Kind="Warehouse"
                                                 Width="22" Height="22"
                                                 Foreground="{DynamicResource AppOnAccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STEX-INV"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}" />
                        <TextBlock Text="{Binding WarehouseName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppMutedBrush}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Acciones del equipo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding UnbindCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="40"
                            Padding="12,0"
                            Foreground="{DynamicResource AppDangerTextBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LinkOff"
                                                     Width="18" Height="18"
                                                     Foreground="{DynamicResource AppDangerTextBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Desvincular equipo"
                                       Foreground="{DynamicResource AppDangerTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24"
                            Background="{DynamicResource AppBorderBrush}"
                            Margin="10,0,12,0" />

                    <Button Command="{Binding SyncCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Padding="16,0"
                            Background="{DynamicResource AppAccentBrush}"
                            Foreground="{DynamicResource AppOnAccentBrush}"
                            BorderThickness="0"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsBusy}"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSyncOutline"
                                                     Width="18" Height="18"
                                                     Foreground="{DynamicResource AppOnAccentBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Actualizar"
                                       Foreground="{DynamicResource AppOnAccentBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32">
                <TextBlock Text="Selecciona tu operario"
                           FontSize="30" FontWeight="Black"
                           Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="Elige tu nombre para ingresar el PIN de 4 dígitos."
                           FontSize="14"
                           Foreground="{DynamicResource AppMutedBrush}"
                           Margin="0,6,0,24" />

                <!-- Aviso de sincronización -->
                <Border CornerRadius="8"
                        Padding="16,14"
                        Margin="0,0,0,16"
                        Background="{DynamicResource AppDangerBackgroundBrush}"
                        BorderBrush="{DynamicResource AppDangerBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="AlertCircleOutline"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource AppDangerTextBrush}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,1,10,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="No se pudo sincronizar"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppDangerTextBrush}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppDangerTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Re-vincular"
                                Command="{Binding ReenrollCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource AppDangerTextBrush}"
                                BorderBrush="{DynamicResource AppDangerBorderBrush}"
                                Height="34"
                                Padding="12,0"
                                Margin="14,0,0,0" />
                    </Grid>
                </Border>

                <!-- Buscador -->
                <!-- Ajuste: Añadido HintAssist.Background y corregido el modo Flotante -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Buscar operario" 
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{DynamicResource AppTextBrush}"
                             Background="{DynamicResource AppSurfaceBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             CaretBrush="{DynamicResource AppTextBrush}"
                             materialDesign:HintAssist.Hint="Escribe un nombre..."
                             materialDesign:HintAssist.IsFloating="False"
                             materialDesign:HintAssist.Foreground="{DynamicResource AppMutedBrush}"
                             materialDesign:HintAssist.Background="{DynamicResource AppSurfaceBrush}"
                             FontSize="14"
                             Height="48"
                             Padding="12,0"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Título de la lista -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,12">
                    <TextBlock Text="Operarios"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AppAccentSoftBrush}"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Operators.Count}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentDarkBrush}" />
                    </Border>
                </StackPanel>

                <!-- Lista de operarios -->
                <Grid>
                    <ItemsControl ItemsSource="{Binding Operators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OperatorCardButtonStyle}"
                                        Command="{Binding DataContext.SelectOperatorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="20">
                                        <StackPanel>
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AppAccentSoftBrush}">
                                                <TextBlock Text="{Binding Iniciales}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource AppAccentDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Text="{Binding NombreCompleto}"
                                                       Margin="0,12,0,0"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />

                                            <Border BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,10,0,0"
                                                    Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Ingresar con PIN"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <materialDesign:PackIcon Grid.Column="1"
                                                                             Kind="ChevronRight"
                                                                             Width="16" Height="16"
                                                                             Foreground="{DynamicResource AppAccentTextBrush}"
                                                                             VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource AppAccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource AppAccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado vacío -->
                    <Border Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="32"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <materialDesign:PackIcon Kind="AccountSearchOutline"
                                                     Width="44" Height="44"
                                                     Foreground="{DynamicResource AppMutedBrush}"
                                                     HorizontalAlignment="Center" />
                            <TextBlock Text="No hay operarios disponibles"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="Actualiza los datos del almacén o ajusta la búsqueda."
                                       FontSize="13"
                                       Foreground="{DynamicResource AppMutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,16" />
                            <Button Content="Actualizar ahora"
                                    Command="{Binding SyncCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource AppAccentTextBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    HorizontalAlignment="Center"
                                    Height="38"
                                    Padding="16,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>