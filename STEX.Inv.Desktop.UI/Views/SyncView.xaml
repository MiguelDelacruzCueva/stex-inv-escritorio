<UserControl x:Class="STEX.Inv.Desktop.UI.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SyncBackgroundBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="SyncSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SyncBorderBrush" Color="#E4E6E8" />
        <SolidColorBrush x:Key="SyncTextBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="SyncMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="SyncAccentBrush" Color="#3F51B5" />
        <SolidColorBrush x:Key="SyncAccentSoftBrush" Color="#EEF2FF" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource SyncBackgroundBrush}">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Sincronización"
                       FontSize="30" FontWeight="Black"
                       Foreground="{StaticResource SyncTextBrush}" />
            <TextBlock Text="Actualiza los maestros del almacén y revisa la copia local."
                       FontSize="14"
                       Foreground="{StaticResource SyncMutedBrush}"
                       Margin="0,6,0,24" />

            <Border Background="{StaticResource SyncSurfaceBrush}"
                    BorderBrush="{StaticResource SyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="14"
                            Background="{StaticResource SyncAccentSoftBrush}"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CloudSyncOutline"
                                                 Width="26" Height="26"
                                                 Foreground="{StaticResource SyncAccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WarehouseName}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncTextBrush}" />
                        <TextBlock Text="{Binding LastSyncText}"
                                   FontSize="12"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Sincronizar ahora"
                            Command="{Binding SyncCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="42"
                            Padding="20,0"
                            Background="{StaticResource SyncAccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsBusy}"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsBusy}" />
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,20,0,0">
                <Border Background="{StaticResource SyncSurfaceBrush}"
                        BorderBrush="{StaticResource SyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                 Width="24" Height="24"
                                                 Foreground="{StaticResource SyncAccentBrush}" />
                        <TextBlock Text="MATERIALES"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   Margin="0,10,0,2" />
                        <TextBlock Text="{Binding MaterialesCount}"
                                   FontSize="28" FontWeight="Black"
                                   Foreground="{StaticResource SyncTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SyncSurfaceBrush}"
                        BorderBrush="{StaticResource SyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="AccountHardHat"
                                                 Width="24" Height="24"
                                                 Foreground="{StaticResource SyncAccentBrush}" />
                        <TextBlock Text="OPERARIOS"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   Margin="0,10,0,2" />
                        <TextBlock Text="{Binding OperariosCount}"
                                   FontSize="28" FontWeight="Black"
                                   Foreground="{StaticResource SyncTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SyncSurfaceBrush}"
                        BorderBrush="{StaticResource SyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CalendarCheck"
                                                 Width="24" Height="24"
                                                 Foreground="{StaticResource SyncAccentBrush}" />
                        <TextBlock Text="CAMPAÑAS"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   Margin="0,10,0,2" />
                        <TextBlock Text="{Binding CampanasCount}"
                                   FontSize="28" FontWeight="Black"
                                   Foreground="{StaticResource SyncTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SyncSurfaceBrush}"
                        BorderBrush="{StaticResource SyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                 Width="24" Height="24"
                                                 Foreground="{StaticResource SyncAccentBrush}" />
                        <TextBlock Text="CONTEOS LOCALES"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   Margin="0,10,0,2" />
                        <TextBlock Text="{Binding ConteosCount}"
                                   FontSize="28" FontWeight="Black"
                                   Foreground="{StaticResource SyncTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Setter Property="BorderBrush" Value="#FECACA" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18" Height="18"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                <Setter Property="Foreground" Value="#047857" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Kind" Value="AlertCircleOutline" />
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#047857" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#B91C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SyncSurfaceBrush}"
                    BorderBrush="{StaticResource SyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="20" Height="20"
                                             Foreground="{StaticResource SyncAccentBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,1,10,0" />
                    <StackPanel>
                        <TextBlock Text="Conteos guardados localmente"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SyncTextBrush}" />
                        <TextBlock Text="Los registros de Conteo se conservan en este equipo. La descarga de maestros no elimina los conteos locales."
                                   FontSize="12"
                                   Foreground="{StaticResource SyncMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
