<Application x:Class="STEX.Inv.Desktop.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:STEX.Inv.Desktop.Core.ViewModels;assembly=STEX.Inv.Desktop.Core"
             xmlns:views="clr-namespace:STEX.Inv.Desktop.UI.Views"
             xmlns:converters="clr-namespace:STEX.Inv.Desktop.UI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:EnrollmentViewModel}">
                <views:EnrollmentView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OperatorSelectionViewModel}">
                <views:OperatorSelectionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PinEntryViewModel}">
                <views:PinEntryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ShellViewModel}">
                <views:ShellView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ConteoViewModel}">
                <views:ConteoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LibrosViewModel}">
                <views:LibrosView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SyncViewModel}">
                <views:SyncView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfileView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
